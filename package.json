{
  "name": "tela-compartilhada",
  "version": "1.5.2",
  "description": "Aplicativo para compartilhar tela com amigos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build-exe": "electron-builder --win portable -c.publish=never",
    "build-linux": "electron-builder --linux AppImage -c.publish=never"
  },
  "author": "Amigos",
  "license": "MIT",
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.amigos.telacompartilhada",
    "productName": "TelaCompartilhada",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/peerjs/dist/peerjs.min.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TelaCompartilhada.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "TelaCompartilhada.AppImage",
      "executableArgs": [
        "--no-sandbox"
      ]
    }
  }
}
